{
  "manifest_version": 3,
  "name": "Claude Sweeper",
  "version": "1.4",
  "description": "Closes idle agent tab groups before Chrome can save them as chips in the bookmarks bar.",
  "permissions": ["tabs", "tabGroups", "storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon.png"
  }
}
